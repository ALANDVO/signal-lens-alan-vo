# SignalLens Environment Configuration

# Application Mode: 'demo' or 'production'
APP_ENV=demo
PORT=8000
HOST=127.0.0.1

# Database
DATABASE_URL=sqlite+aiosqlite:///./signallens.db

# Authentication / OIDC Settings
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/signallens
OIDC_CLIENT_ID=signallens-app
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=signallens-app

# LLM Advisory Service (Opt-in, non-secret defaults)
# Only LLM_API_KEY is secret and kept server-side.
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
